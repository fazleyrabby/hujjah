# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large pre-seeded database vault (generated, not source)
/public/hujjah-vault/
/public/hujjah-vault-manifest.json

# Node.js seeding output
/pglite_data/

# Dev notes / agent handover (local only)
AGENTS.md
CLAUDE.md
DATAIMPORT.md
dist/
*.db
CLAUDE_HANDOVER.md

# Tauri build artifacts
/src-tauri/target/
/src-tauri/gen/
/src-tauri/Cargo.lock
apps/tauri/src-tauri/target/
apps/tauri/src-tauri/gen/
apps/tauri/src-tauri/Cargo.lock

# Model files (large binaries)
/src-tauri/resources/models/
apps/tauri/src-tauri/resources/models/

# Web dev DB symlinks
apps/web/data/

# Nested node_modules (pnpm workspace)
packages/*/node_modules/
apps/*/node_modules/
apps/tauri/node_modules/

# macOS
.DS_Store

# Local docs (except references)
# docs/   # Uncomment to ignore local docs
!docs/references.md
AI-CHATBOT-TEST-QUERIES.md
test_rag.py
scripts/__pycache__/

*.db-shm
*.db-wal
apps/tauri/.next/
apps/web/.next/
